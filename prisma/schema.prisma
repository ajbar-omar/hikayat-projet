// هادا كيعلم بريسما بلي غانخدمو بـ PostgreSQL (أو SQLite للتيست)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// جدول الأب (الحساب الرئيسي)
model Parent {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  children  Child[]  // علاقة: الأب يقدر يكون عندو بزاف ديال الأطفال
  createdAt DateTime @default(now())
}

// جدول الطفل (البروفايل اللي كيلعب)
model Child {
  id           String   @id @default(cuid())
  name         String
  avatar       String?  // رابط الصورة الكرتونية
  xp           Int      @default(0)    // نقاط الخبرة
  level        Int      @default(1)    // المستوى
  parentId     String
  parent       Parent   @relation(fields: [parentId], references: [id])
  achievements Achievement[]
}

// جدول الأوسمة (Badges)
model Achievement {
  id        String   @id @default(cuid())
  badgeName String   // مثلاً: "المستكشف الأول"
  earnedAt  DateTime @default(now())
  childId   String
  child     Child    @relation(fields: [childId], references: [id])
}